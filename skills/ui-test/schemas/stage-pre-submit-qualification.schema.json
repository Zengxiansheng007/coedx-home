{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ui-test.stage-pre-submit-qualification.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "branch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "build_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stage_write_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "branch_id",
        "phase_ids",
        "contract",
        "max_per_phase",
        "budget_hash"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "branch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "phase_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,80}$"
          }
        },
        "contract": {
          "const": "stage-budget-v1"
        },
        "max_per_phase": {
          "const": 1
        },
        "budget_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "qualification_scope": {
      "enum": [
        "first-write-boundary",
        "phase-boundary"
      ]
    },
    "qualified_phase_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "deferred_phase_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,128}$"
      }
    },
    "prior_submit_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "current_phase_submit_count": {
      "const": 0
    },
    "step_results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "screenshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "screenshot_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "overall_status": {
      "const": "passed"
    },
    "sequence_allocated": {
      "const": false
    },
    "qualification_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "branch_id",
    "build_fingerprint",
    "stage_write_budget",
    "qualification_scope",
    "qualified_phase_id",
    "deferred_phase_ids",
    "prior_submit_count",
    "current_phase_submit_count",
    "step_results",
    "screenshot_ref",
    "screenshot_sha256",
    "overall_status",
    "sequence_allocated",
    "qualification_hash"
  ]
}
