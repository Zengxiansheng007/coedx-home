{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/run-result.schema.v5.json",
  "title": "Run Result V5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transaction_id",
    "session_id",
    "run_id",
    "node_id",
    "case_id",
    "branch_id",
    "resolved_test_data_ref",
    "resolved_test_data_hash",
    "execution_context_ref",
    "execution_context_hash",
    "attempt_ref",
    "pre_terminal_events_hash",
    "approval_ref",
    "approval_hash",
    "pytest_phase_status",
    "overall_status",
    "write_state",
    "submit_count",
    "step_results",
    "evidence_refs",
    "conflicts",
    "findings",
    "retained_test_data",
    "cleanup_status",
    "business_cleanup_attempted",
    "run_result_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "ui-test.run-result.v5"
    },
    "transaction_id": {
      "$ref": "#/$defs/stableIdentity"
    },
    "session_id": {
      "$ref": "#/$defs/stableIdentity"
    },
    "run_id": {
      "$ref": "#/$defs/stableIdentity"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "case_id": {
      "$ref": "#/$defs/stableIdentity"
    },
    "branch_id": {
      "$ref": "#/$defs/stableIdentity"
    },
    "resolved_test_data_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/relativeRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolved_test_data_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_context_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/relativeRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_context_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_ref": {
      "$ref": "#/$defs/relativeRef"
    },
    "pre_terminal_events_hash": {
      "$ref": "#/$defs/hash"
    },
    "approval_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/relativeRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "pytest_phase_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup",
        "call",
        "teardown"
      ],
      "properties": {
        "setup": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "unknown"
          ]
        },
        "call": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "not_run",
            "unknown"
          ]
        },
        "teardown": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "unknown"
          ]
        }
      }
    },
    "overall_status": {
      "enum": [
        "passed",
        "degraded",
        "failed",
        "blocked",
        "unknown"
      ]
    },
    "write_state": {
      "enum": [
        "not_attempted",
        "submitted_unknown",
        "write_succeeded_verified",
        "write_succeeded_verification_failed",
        "write_failed",
        "write_outcome_unknown"
      ]
    },
    "submit_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 16
    },
    "step_results": {
      "type": "array"
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativeRef"
      }
    },
    "conflicts": {
      "type": "array"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "not": {
          "pattern": "(?i)(password|secret|token|cookie|authorization|api[_-]?key)"
        }
      }
    },
    "retained_test_data": {
      "type": "array"
    },
    "cleanup_status": {
      "enum": [
        "not_applicable",
        "not_planned_this_release"
      ]
    },
    "business_cleanup_attempted": {
      "const": false
    },
    "run_result_hash": {
      "$ref": "#/$defs/hash"
    },
    "stage_write_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "branch_id",
        "phase_ids",
        "contract",
        "max_per_phase",
        "budget_hash"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "branch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "phase_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,80}$"
          }
        },
        "contract": {
          "const": "stage-budget-v1"
        },
        "max_per_phase": {
          "const": 1
        },
        "budget_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "phase_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase_id",
          "submit_count",
          "write_state"
        ],
        "properties": {
          "phase_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "submit_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "write_state": {
            "enum": [
              "not_attempted",
              "write_succeeded_verified",
              "write_outcome_unknown",
              "write_succeeded_verification_failed",
              "write_failed"
            ]
          }
        }
      }
    },
    "artifact_absence": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "resolved_test_data": {
          "const": "E_NOT_OBSERVED"
        },
        "execution_context": {
          "const": "E_NOT_OBSERVED"
        },
        "approval": {
          "const": "E_NOT_OBSERVED"
        },
        "business_observation": {
          "const": "E_NOT_OBSERVED"
        }
      }
    },
    "business_observation_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/relativeRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "business_observation_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "prepare",
          "setup",
          "call",
          "teardown",
          "finalization"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "pytest_phase_status": {
            "properties": {
              "setup": {
                "const": "passed"
              },
              "call": {
                "const": "passed"
              },
              "teardown": {
                "const": "passed"
              }
            }
          },
          "write_state": {
            "const": "write_succeeded_verified"
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "stage_write_budget"
          ]
        }
      },
      "then": {
        "properties": {
          "submit_count": {
            "maximum": 1
          }
        },
        "not": {
          "required": [
            "phase_results"
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "overall_status": {
                  "const": "passed"
                }
              }
            },
            "then": {
              "properties": {
                "submit_count": {
                  "const": 1
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "stage_write_budget"
        ]
      },
      "then": {
        "required": [
          "phase_results"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "resolved_test_data_ref"
            ],
            "properties": {
              "resolved_test_data_ref": {
                "type": "null"
              }
            }
          },
          {
            "required": [
              "resolved_test_data_hash"
            ],
            "properties": {
              "resolved_test_data_hash": {
                "type": "null"
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "artifact_absence"
        ],
        "properties": {
          "resolved_test_data_ref": {
            "type": "null"
          },
          "resolved_test_data_hash": {
            "type": "null"
          },
          "overall_status": {
            "const": "failed"
          },
          "artifact_absence": {
            "required": [
              "resolved_test_data"
            ]
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "execution_context_ref"
            ],
            "properties": {
              "execution_context_ref": {
                "type": "null"
              }
            }
          },
          {
            "required": [
              "execution_context_hash"
            ],
            "properties": {
              "execution_context_hash": {
                "type": "null"
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "artifact_absence"
        ],
        "properties": {
          "execution_context_ref": {
            "type": "null"
          },
          "execution_context_hash": {
            "type": "null"
          },
          "overall_status": {
            "const": "failed"
          },
          "artifact_absence": {
            "required": [
              "execution_context"
            ]
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "approval_ref"
            ],
            "properties": {
              "approval_ref": {
                "type": "null"
              }
            }
          },
          {
            "required": [
              "approval_hash"
            ],
            "properties": {
              "approval_hash": {
                "type": "null"
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "artifact_absence"
        ],
        "properties": {
          "approval_ref": {
            "type": "null"
          },
          "approval_hash": {
            "type": "null"
          },
          "overall_status": {
            "const": "failed"
          },
          "artifact_absence": {
            "required": [
              "approval"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "artifact_absence"
        ]
      },
      "then": {
        "required": [
          "failure_phases"
        ],
        "properties": {
          "overall_status": {
            "const": "failed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "submit_count": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": [
          "artifact_absence"
        ],
        "properties": {
          "write_state": {
            "const": "write_outcome_unknown"
          },
          "artifact_absence": {
            "required": [
              "business_observation"
            ]
          },
          "overall_status": {
            "const": "failed"
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stableIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "relativeRef": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^(?:[A-Za-z]:|/|\\\\)"
          },
          {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          },
          {
            "pattern": "(?i)(password|secret|token|cookie|authorization|api[_-]?key)"
          }
        ]
      }
    }
  }
}
